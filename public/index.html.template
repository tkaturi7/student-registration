@@LT@@!DOCTYPE html@@GT@@
@@LT@@html lang="en"@@GT@@
@@LT@@head@@GT@@
  @@LT@@meta charset="UTF-8"@@GT@@
  @@LT@@meta name="viewport" content="width=device-width, initial-scale=1.0"@@GT@@
  @@LT@@title@@GT@@Student Registration@@LT@@/title@@GT@@

  @@LT@@style@@GT@@
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 30px;
    }

    .container {
      width: min(520px, 100%);
      background: #ffffff;
      border-radius: 18px;
      padding: 35px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
    }

    .header {
      text-align: center;
      margin-bottom: 25px;
    }

    .header h2 {
      margin: 0;
      color: #1e3c72;
      font-size: 30px;
    }

    .header p {
      margin-top: 8px;
      color: #666666;
      font-size: 14px;
    }

    label {
      display: block;
      font-weight: bold;
      color: #333333;
      margin-bottom: 6px;
    }

    input {
      width: 100%;
      padding: 13px;
      margin-bottom: 18px;
      border: 1px solid #cccccc;
      border-radius: 8px;
      font-size: 15px;
      outline: none;
    }

    input:focus {
      border-color: #2a5298;
      box-shadow: 0 0 0 3px rgba(42, 82, 152, 0.15);
    }

    input[type="file"] {
      padding: 10px;
      background: #f7f9fc;
    }

    button {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #00b09b, #96c93d);
      color: white;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      font-size: 17px;
      font-weight: bold;
    }

    button:hover {
      background: linear-gradient(135deg, #009688, #7cb342);
    }

    button:disabled {
      cursor: wait;
      opacity: 0.7;
    }

    .footer {
      text-align: center;
      margin-top: 18px;
      font-size: 13px;
      color: #777777;
    }
  @@LT@@/style@@GT@@
@@LT@@/head@@GT@@

@@LT@@body@@GT@@
  @@LT@@div class="container"@@GT@@
    @@LT@@div class="header"@@GT@@
      @@LT@@h2@@GT@@Student Registration@@LT@@/h2@@GT@@
      @@LT@@p@@GT@@Submit student details and upload a resume.@@LT@@/p@@GT@@
    @@LT@@/div@@GT@@

    @@LT@@form
      id="registration-form"
      action="/register"
      method="POST"
      enctype="multipart/form-data"
    @@GT@@
      @@LT@@label for="student_name"@@GT@@Student Name@@LT@@/label@@GT@@
      @@LT@@input
        type="text"
        id="student_name"
        name="student_name"
        placeholder="Enter student name"
        maxlength="100"
        required
      @@GT@@

      @@LT@@label for="student_id"@@GT@@Student ID@@LT@@/label@@GT@@
      @@LT@@input
        type="text"
        id="student_id"
        name="student_id"
        placeholder="Enter student ID"
        maxlength="50"
        required
      @@GT@@

      @@LT@@label for="contact_no"@@GT@@Contact Number@@LT@@/label@@GT@@
      @@LT@@input
        type="tel"
        id="contact_no"
        name="contact_no"
        placeholder="Enter contact number"
        maxlength="20"
        required
      @@GT@@

      @@LT@@label for="location"@@GT@@Location@@LT@@/label@@GT@@
      @@LT@@input
        type="text"
        id="location"
        name="location"
        placeholder="Enter location"
        maxlength="100"
        required
      @@GT@@

      @@LT@@label for="resume"@@GT@@Resume@@LT@@/label@@GT@@
      @@LT@@input
        type="file"
        id="resume"
        name="resume"
        accept=".pdf,.doc,.docx"
        required
      @@GT@@

      @@LT@@button id="submit-button" type="submit"@@GT@@
        Submit Registration
      @@LT@@/button@@GT@@
    @@LT@@/form@@GT@@

    @@LT@@div class="footer"@@GT@@
      Student Registration Kubernetes Lab
    @@LT@@/div@@GT@@
  @@LT@@/div@@GT@@

  @@LT@@script@@GT@@
    const form = document.getElementById("registration-form");
    const submitButton = document.getElementById("submit-button");

    form.addEventListener("submit", () => {
      submitButton.disabled = true;
      submitButton.textContent = "Submitting...";
    });
  @@LT@@/script@@GT@@
@@LT@@/body@@GT@@
@@LT@@/html@@GT@@
